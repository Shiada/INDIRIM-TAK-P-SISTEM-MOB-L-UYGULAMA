<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Indirimci.Converters"
             x:Class="Indirimci.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colors -->
            <Color x:Key="BgPrimary">#0f0f23</Color>
            <Color x:Key="BgSecondary">#1a1a2e</Color>
            <Color x:Key="BgCard">#16213e</Color>
            <Color x:Key="BgCardHover">#1c2b4a</Color>
            <Color x:Key="BgInput">#1e2a45</Color>
            <Color x:Key="AccentPrimary">#e94560</Color>
            <Color x:Key="AccentSecondary">#0f3460</Color>
            <Color x:Key="TextPrimary">#ffffff</Color>
            <Color x:Key="TextSecondary">#a8b2d1</Color>
            <Color x:Key="TextMuted">#6c7a9c</Color>
            <Color x:Key="BorderColor">#1f2b47</Color>
            <Color x:Key="GreenAccent">#2ecc71</Color>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToStringConverter x:Key="BoolToStringConverter" />

            <!-- Styles -->
            <Style x:Key="PageStyle" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource BgPrimary}" />
            </Style>

            <Style x:Key="CardFrame" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="HasShadow" Value="False" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="16,16,16,8" />
            </Style>

            <Style x:Key="BodyText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentPrimary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="HeightRequest" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
