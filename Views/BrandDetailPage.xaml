<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Indirimci.Views.BrandDetailPage"
             BackgroundColor="{StaticResource BgPrimary}"
             Shell.BackgroundColor="{StaticResource BgPrimary}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Brand Header -->
            <Grid Padding="20" ColumnDefinitions="80,*" ColumnSpacing="16">
                <Frame Grid.Column="0" x:Name="BrandLogoFrame" WidthRequest="80" HeightRequest="80" CornerRadius="16" Padding="0" HasShadow="False" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="BrandLogoLabel" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label x:Name="BrandNameLabel" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="BrandCategoryLabel" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                    <Button x:Name="TrackButton" Style="{StaticResource AccentButton}" Margin="0,8,0,0" HorizontalOptions="Start" HeightRequest="40" FontSize="13" Clicked="OnTrackClicked" />
                </VerticalStackLayout>
            </Grid>

            <!-- Category Filter -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="8,0,8,8">
                <HorizontalStackLayout x:Name="BrandCategoryChips" Spacing="8" Padding="8,4" />
            </ScrollView>

            <!-- Deals List -->
            <VerticalStackLayout x:Name="DealsContainer" Padding="16,0" Spacing="8" />

            <!-- Empty State -->
            <VerticalStackLayout x:Name="EmptyState" IsVisible="False" Padding="32" Spacing="8" HorizontalOptions="Center">
                <Label Text="📭" FontSize="48" HorizontalTextAlignment="Center" />
                <Label Text="Henüz indirim yok" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Bu kategoride şu an aktif indirim bulunmuyor." FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <BoxView HeightRequest="20" Color="Transparent" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
