<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Indirimci.Views.BrandsPage"
             Title="Markalar"
             BackgroundColor="{StaticResource BgPrimary}"
             Shell.BackgroundColor="{StaticResource BgPrimary}">

    <Grid RowDefinitions="Auto,*">
        <!-- Category Filter Chips -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="8,8,8,0">
            <HorizontalStackLayout x:Name="FilterChips" Spacing="8" Padding="8,4" />
        </ScrollView>

        <!-- Brands Grid -->
        <CollectionView Grid.Row="1" x:Name="BrandsCV" Margin="8,8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="16" CornerRadius="16" BackgroundColor="{StaticResource BgCard}" BorderColor="{StaticResource BorderColor}" HasShadow="False">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBrandTapped" CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                            <!-- Deal Badge -->
                            <Frame Grid.Row="0" BackgroundColor="{StaticResource AccentPrimary}" CornerRadius="8" Padding="6,2" HasShadow="False" HorizontalOptions="End" IsVisible="{Binding ActiveDealCount, Converter={StaticResource InverseBoolConverter}}">
                                <Label Text="{Binding ActiveDealCount, StringFormat='{0} indirim'}" FontSize="10" FontAttributes="Bold" TextColor="White" />
                            </Frame>
                            <!-- Brand Logo -->
                            <Frame Grid.Row="1" WidthRequest="56" HeightRequest="56" CornerRadius="12" Padding="0" HasShadow="False" BackgroundColor="{Binding GradientStart}" HorizontalOptions="Center">
                                <Label Text="{Binding LogoText}" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <Label Grid.Row="2" Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                            <Label Grid.Row="3" Text="{Binding CategoryName}" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
