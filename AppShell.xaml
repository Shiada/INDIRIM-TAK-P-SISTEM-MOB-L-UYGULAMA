<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Indirimci.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Indirimci.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#0f0f23"
    Shell.TabBarForegroundColor="#e94560"
    Shell.TabBarTitleColor="#e94560"
    Shell.TabBarUnselectedColor="#6c7a9c"
    Shell.BackgroundColor="#0f0f23"
    Shell.ForegroundColor="White">

    <TabBar>
        <ShellContent
            Title="Ana Sayfa"
            Icon="home_icon.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />
        <ShellContent
            Title="Markalar"
            Icon="store_icon.png"
            ContentTemplate="{DataTemplate views:BrandsPage}"
            Route="brands" />
        <ShellContent
            Title="Bildirimler"
            Icon="bell_icon.png"
            ContentTemplate="{DataTemplate views:NotificationsPage}"
            Route="notifications" />
        <ShellContent
            Title="Tercihler"
            Icon="settings_icon.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
